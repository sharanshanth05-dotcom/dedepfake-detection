# TruthLens AI Environment Configuration

# Application
PROJECT_NAME="TruthLens AI"
PROJECT_VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration
# Default: Local SQLite (zero setup)
DATABASE_URL="sqlite:///./truthlens.db"
# Production MySQL Example:
# DATABASE_URL="mysql+pymysql://truthlens_user:SecurePassword123@localhost:3306/truthlens_db"

# Security & Cryptography
SECRET_KEY="cybersecurity-secret-key-truthlens-ai-2026-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload Limits (in Megabytes)
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=100
MAX_AUDIO_SIZE_MB=40

# Video Sampling Configuration
VIDEO_SAMPLE_FPS=1.0
MAX_VIDEO_FRAMES=30

# Model Backbones
DEFAULT_VIT_IMAGE_MODEL="google/vit-base-patch16-224"
DEFAULT_AUDIO_MODEL="facebook/wav2vec2-base"

# Frontend Configuration
VITE_API_URL="http://localhost:8000/api/v1"
